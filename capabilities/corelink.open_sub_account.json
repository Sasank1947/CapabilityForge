{
  "schemaVersion": "capabilityforge/v1",
  "id": "corelink.open_sub_account",
  "version": "1.0.0",
  "status": "approved",
  "title": "Open a member sub-account",
  "description": "Signs on to CoreLink Teller, opens a member, fills the open-sub-account form, reviews the posting and submits it. Submit is irreversible. Returns the confirmation number.",
  "provenance": {
    "source": "hand-written",
    "recordedAt": "2026-10-11T20:00:00.000Z",
    "recordedOnTenant": "a"
  },
  "app": {
    "vendor": "CoreLink",
    "product": "Teller",
    "versionRange": ">=7.4 <8",
    "surface": "legacy-web",
    "entryRoute": "/login",
    "fingerprint": {
      "titlePattern": "CoreLink Teller",
      "versionText": "v7.4.2",
      "landmarks": [
        "Member Inquiry",
        "OPERATOR SIGN ON"
      ]
    }
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "Five-digit member number",
      "sensitivity": "pii",
      "required": true,
      "pattern": "^[0-9]{5}$",
      "example": "12345"
    },
    "accountType": {
      "type": "string",
      "description": "Sub-account type code",
      "sensitivity": "internal",
      "required": true,
      "enum": [
        "S20",
        "S30",
        "S40",
        "D20"
      ],
      "example": "S20"
    },
    "nickname": {
      "type": "string",
      "description": "Optional nickname (letters, digits, space, hyphen; max 20)",
      "sensitivity": "internal",
      "required": false,
      "maxLength": 20,
      "example": "XMAS FUND"
    },
    "deposit": {
      "type": "string",
      "description": "Opening deposit amount, e.g. 100.00",
      "sensitivity": "pii",
      "required": true,
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "example": "100.00"
    },
    "fromSuffix": {
      "type": "string",
      "description": "Funding account suffix",
      "sensitivity": "internal",
      "required": true,
      "pattern": "^[A-Z][0-9]{2}$",
      "example": "S01"
    }
  },
  "outputs": {
    "confirmationNumber": {
      "type": "string",
      "description": "Posted confirmation number",
      "sensitivity": "internal",
      "extraction": {
        "target": {
          "description": "Confirmation number value",
          "framePath": [
            "main"
          ],
          "strategies": [
            {
              "kind": "label",
              "labelText": "Confirmation Number:",
              "relation": "right-of",
              "exact": true
            }
          ],
          "cardinality": "exactlyOne"
        },
        "read": "text",
        "transforms": [
          {
            "kind": "trim"
          }
        ]
      }
    },
    "newSuffix": {
      "type": "string",
      "description": "Suffix of the newly opened account",
      "sensitivity": "internal",
      "extraction": {
        "target": {
          "description": "New account cell",
          "framePath": [
            "main"
          ],
          "strategies": [
            {
              "kind": "label",
              "labelText": "New Account:",
              "relation": "right-of",
              "exact": true
            }
          ],
          "cardinality": "exactlyOne"
        },
        "read": "text",
        "transforms": [
          {
            "kind": "trim"
          },
          {
            "kind": "regex",
            "pattern": "^([A-Z]\\d{2})",
            "group": 1
          }
        ]
      }
    }
  },
