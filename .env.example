# Required only for `forge discover` (the LLM-driven run). Replay, tests and the mock app run without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Synthetic operator credentials for the CoreLink mock app. Artifacts reference these
# as secretRefs (env://CORELINK_USER); the values never appear in artifacts or logs.
CORELINK_USER=teller01
CORELINK_PASSWORD=change-me-local-only

CORELINK_PORT=4100
